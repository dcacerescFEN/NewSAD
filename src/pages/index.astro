---
import Card from '../components/Card.astro';
import Layout from '../layouts/Layout.astro';
import Report from '../components/Report.astro';

// Welcome to Astro! Wondering what to do next? Check out the Astro documentation at https://docs.astro.build
// Don't want to use any of this? Delete everything in this file, the `assets`, `components`, and `layouts` directories, and start fresh.
---

<Layout>
	<div class="container-fluid">
		<div class="row mt-3">
			<div class="col-md-3 mb-3">
				<Card
					title="Alumnos"
					text="Gestiona la información de los estudiantes, sus datos personales y académicos."
					icon="bi bi-person-badge"
				/>
			</div>
			<div class="col-md-3 mb-3">
				<Card
					title="Profesores"
					text="Administra los datos de los profesores, incluyendo asignaturas y horarios."
					icon="bi bi-person-lines-fill"
				/>
			</div>
			<div class="col-md-3 mb-3">
				<Card
					title="Cursos"
					text="Visualiza y gestiona los cursos disponibles, sus descripciones y requisitos."
					icon="bi bi-book"
				/>
			</div>
			<div class="col-md-3 mb-3">
				<Card
					title="Exámenes"
					text="Crea y gestiona los exámenes, incluyendo fechas y resultados."
					icon="bi bi-clipboard-check"
				/>
			</div>
		</div>
		<div class="row">
			<div class="col-md-3 mb-3">
				<Card
					title="Actividades"
					text="Crea y organiza las actividades académicas y extracurriculares."
					icon="bi bi-calendar-event"
				/>

			</div>
			<div class="col-md-3 mb-3">
				<Card
					title="Ayudantes"
					text="Gestiona la información de los ayudantes de cátedra y sus asignaciones."
					icon="bi bi-people"
				/>
			</div>
			<div class="col-md-3 mb-3">
				<Card
					title="Proceso"
					text="Visualiza el estado del proceso académico y administrativo."
					icon="bi bi-gear"
				/>
			</div>
			<div class="col-md-3 mb-3">
				<Card
					title="Administración"
					text="Accede a las herramientas de administración del sistema."
					icon="bi bi-shield-lock"
					color="bg-danger"
				/>
			</div>
		</div>

		<Report />
	</div>
</Layout>
